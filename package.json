{
  "name": "dobby",
  "version": "0.8.0",
  "private": true,
  "license": "MIT",
  "description": "Dobby — AI VTuber control room for Codex and TikTok LIVE Studio",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "start": "electron .",
    "pretest": "node scripts/build.mjs",
    "test": "tsx --test tests/*.test.ts",
    "package": "npm run build && electron-builder --mac dir",
    "release:mac": "bash scripts/release-mac.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "lucide-react": "^0.468.0",
    "pixi.js": "^6.5.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "electron": "45.4.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "app.dobby.desktop",
    "productName": "Dobby",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "assets/branding/dobby-original-elf-ai-v1.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Dobby uses your selected audio input to animate the avatar's mouth."
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "artifactName": "Dobby-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Dobby ${version}",
      "sign": true
    }
  }
}
